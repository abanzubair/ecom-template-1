# =========================================================================
# Weave365 Reseller Storefront Template Configuration
# =========================================================================

# The main Weave365 Storefront API endpoint
NEXT_PUBLIC_WEAVE365_API_URL=https://weave365.com/api/storefront

# Your unique Reseller Store Slug (configured in your Weave365 Business Center)
NEXT_PUBLIC_RESELLER_SLUG=your-store-slug

# (Optional) If you have mapped a custom domain in Weave365 Business Center
# NEXT_PUBLIC_RESELLER_DOMAIN=yourdomain.com

# Centralized Weave365 Reseller Portal URL
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://reseller.weave365.com
